<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>local.townevolution.foundation</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <_ApkDebugKeyStore>$(MSBuildThisFileDirectory)..\..\.tools\android-signing\debug.keystore</_ApkDebugKeyStore>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.6" />
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.6" />
    <ProjectReference Include="../Town.Core/Town.Core.csproj" />
  </ItemGroup>
  <Import Project="../Town.Game/Town.Game.projitems" Label="Shared" />
</Project>
