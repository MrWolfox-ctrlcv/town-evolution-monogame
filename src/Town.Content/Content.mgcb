# Generated by scripts/convert-gltf.mjs; compile via official MonoGame Content Builder.
/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:HiDef
/compress:False

